# ==============================================================
# .env.cpanel - Template .env untuk Produksi cPanel
# ==============================================================
# Salin file ini sebagai .env di server cPanel
# JANGAN commit file ini ke GitHub!

APP_NAME="SIT Robbani SmartEdu"
APP_ENV=production
APP_KEY=base64:GANTI_DENGAN_HASIL_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://sitrobbani.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =====================
# DATABASE - MySQL CPanel
# =====================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=namauser_sitrobbani
DB_USERNAME=namauser_sitrobbani
DB_PASSWORD=PASSWORD_MYSQL_CPANEL_ANDA

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sitrobbani.sch.id

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.sitrobbani.sch.id
MAIL_PORT=465
MAIL_USERNAME=no-reply@sitrobbani.sch.id
MAIL_PASSWORD=PASSWORD_EMAIL_CPANEL
MAIL_FROM_ADDRESS="no-reply@sitrobbani.sch.id"
MAIL_FROM_NAME="SIT Robbani"

VITE_APP_NAME="SIT Robbani SmartEdu"

# ==============================================================================
# SMA IT ISHLAHUL UMMAH - UPLOADS DIRECTORY SECURITY LAYER
# PREVENT ARBITRARY CODE EXECUTION IN USER-ACCESSIBLE UPLOADS
# ==============================================================================

# 1. Disable directory browsing and CGI execution
Options -Indexes -ExecCGI

# 2. Deny direct access and execution for all script and executable file types
<FilesMatch "(?i)\.(php|phtml|php[0-9]|phps|pht|phar|cgi|pl|py|sh|bash|exe|bat|cmd|suspected|htaccess|htpasswd|env|ini|inc|config|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Disable PHP engine execution inside uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 4. Enforce nosniff so browsers don't execute disguised files
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
